---
import { campaign } from "../content";
const { why } = campaign.geoscience;
---

<section class="section why">
  <div class="container">
    <h2>{why.title}</h2>
    <ul class="why-grid">
      {why.bullets.map((b) => (
        <li class="why-card">{b}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why-grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .why-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .why-card {
    background: var(--fabriq-lavender-100);
    padding: 1.5rem 1.25rem;
    border-radius: var(--radius);
    color: var(--fabriq-purple-700);
    font-weight: 500;
    line-height: 1.45;
    box-shadow: var(--shadow);
  }
</style>
