---
import { campaign } from "../content";
const { hero } = campaign.geoscience;
---

<section class="section hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">explainable ai</p>
      <h1>{hero.title}</h1>
      <p class="hero__sub">{hero.subtitle}</p>
      <a href="#contact" class="btn">{hero.cta}</a>
    </div>
    <div class="hero__visual">
      <img
        src="/brand/fabriq-grafikk.png"
        alt=""
        width="800"
        height="704"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 2rem;
    background: linear-gradient(
      180deg,
      var(--fabriq-white) 0%,
      var(--fabriq-surface-muted) 100%
    );
  }
  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
    }
  }
  .hero__eyebrow {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    color: var(--fabriq-purple-500);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .hero__sub {
    color: var(--fabriq-purple-700);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    margin-bottom: 1.75rem;
    max-width: 36rem;
  }
  .hero__visual {
    min-width: 0;
  }
  .hero__visual img {
    display: block;
    width: 100%;
    max-width: 440px;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
  }
</style>
