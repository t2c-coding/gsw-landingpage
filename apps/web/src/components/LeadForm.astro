---
import { campaign } from "../content";
const { cta, form } = campaign.geoscience;
const apiBase = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3022";
---

<section class="section" id="contact">
  <div class="container contact">
    <h2>{cta.formTitle}</h2>

    <form class="form" id="lead-form" novalidate>
      <div class="hp" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form__row">
        <label for="email">{form.email} *</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>
      <div class="form__row">
        <label for="name">{form.name} *</label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>
      <div class="form__row">
        <label for="company">{form.company} *</label>
        <input type="text" id="company" name="company" required autocomplete="organization" />
      </div>
      <div class="form__row">
        <label for="role">{form.role}</label>
        <input type="text" id="role" name="role" autocomplete="organization-title" />
      </div>
      <div class="form__row">
        <label for="message">{form.message}</label>
        <textarea id="message" name="message" rows="3"></textarea>
      </div>
      <div class="form__row form__row--check">
        <input type="checkbox" id="consent" name="consent" required />
        <label for="consent">{form.consent} <a href="/privacy">Privacy policy</a></label>
      </div>

      <p class="form__status" id="form-status" role="status" aria-live="polite"></p>
      <button type="submit" class="btn" id="submit-btn">{cta.button}</button>
    </form>
  </div>
</section>

<script define:vars={{ apiBase, successMsg: form.success, errorMsg: form.error }}>
  const formEl = document.getElementById("lead-form");
  const statusEl = document.getElementById("form-status");
  const submitBtn = document.getElementById("submit-btn");

  formEl?.addEventListener("submit", async (e) => {
    e.preventDefault();
    statusEl.textContent = "";
    submitBtn.disabled = true;

    const fd = new FormData(formEl);
    const payload = {
      email: fd.get("email"),
      name: fd.get("name"),
      company: fd.get("company"),
      role: fd.get("role") || undefined,
      message: fd.get("message") || undefined,
      website: fd.get("website") || "",
      campaign: "geoscience",
      utm_source: new URLSearchParams(location.search).get("utm_source") || undefined,
      utm_medium: new URLSearchParams(location.search).get("utm_medium") || undefined,
      utm_campaign: new URLSearchParams(location.search).get("utm_campaign") || undefined,
    };

    try {
      const res = await fetch(`${apiBase}/v1/leads`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Request failed");
      statusEl.textContent = successMsg;
      statusEl.className = "form__status form__status--ok";
      formEl.reset();
    } catch {
      statusEl.textContent = errorMsg;
      statusEl.className = "form__status form__status--err";
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .form {
    max-width: 28rem;
    display: grid;
    gap: 1rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }
  .form__row label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
  }
  .form__row input,
  .form__row textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--fabriq-lavender-200);
    border-radius: 8px;
    font: inherit;
  }
  .form__row--check {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .form__row--check input {
    width: auto;
    margin-top: 0.25rem;
  }
  .form__row--check label {
    font-size: 0.85rem;
    font-weight: 400;
  }
  .form__status {
    margin: 0;
    font-size: 0.95rem;
  }
  .form__status--ok {
    color: #0d6b3a;
  }
  .form__status--err {
    color: #b42318;
  }
</style>
