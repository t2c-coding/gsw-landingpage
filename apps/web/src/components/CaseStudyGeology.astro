---
import { campaign } from "../content";
const { caseStudy } = campaign.geoscience;
---

<section class="section">
  <div class="container">
    <h2>{caseStudy.title}</h2>
    <ul class="metrics">
      {caseStudy.metrics.map((m) => (
        <li>{m}</li>
      ))}
    </ul>
    <p class="case-body">{caseStudy.body}</p>
  </div>
</section>

<style>
  .metrics {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .metrics li {
    flex: 1 1 200px;
    background: var(--fabriq-lavender-100);
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .case-body {
    color: var(--fabriq-purple-700);
    max-width: 48rem;
  }
</style>
