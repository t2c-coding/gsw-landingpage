---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Privacy | Fabriq" description="Privacy policy for Fabriq lead capture.">
  <Header />
  <main class="section">
    <div class="container" style="max-width: 40rem">
      <h1>Privacy policy</h1>
      <p>
        When you submit the exploratory call form, we collect your name, email,
        company, role, and optional message to respond to your inquiry. Data is
        stored securely and used only for sales follow-up related to Fabriq
        geoscience solutions.
      </p>
      <p>
        For questions or deletion requests, contact us at the email address
        provided when you hear back from our team.
      </p>
      <p><a href="/">← Back to home</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
